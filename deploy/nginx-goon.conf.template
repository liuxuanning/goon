# Template only. Install TLS certificate and replace example hostname first.
# Production must use HTTPS before reviewer tokens can be entered.
server {
    listen 443 ssl;
    server_name goon.example.com;
    ssl_certificate /etc/letsencrypt/live/goon.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/goon.example.com/privkey.pem;

    location /goon/ {
        proxy_pass http://127.0.0.1:4173/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 128k;
        proxy_read_timeout 180s;
    }
}
